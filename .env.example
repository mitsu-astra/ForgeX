# =============================================================================
# NEURAX Hackathon 3.0 — Visual Inspection & Defect Root-Cause Assistant
# Prototype Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# ENVIRONMENT
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------------
# BACKEND (FastAPI + Uvicorn)
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# FRONTEND (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="ForgeX • Industrial Decision Intelligence"

# ---------------------------------------------------------------------------
# ML MODELS
# ---------------------------------------------------------------------------
VISION_MODEL_WEIGHTS=models/weights/efficientnet_b4_defect.pth
PROCESS_MODEL_WEIGHTS=models/weights/xgboost_process.pkl
CORRELATION_MODEL_WEIGHTS=models/weights/xgboost_correlation.pkl

VISION_MODEL_NAME=efficientnet_b4
VISION_NUM_CLASSES=5
VISION_IMAGE_SIZE=224
VISION_CONFIDENCE_THRESHOLD=0.70
VISION_UNCERTAINTY_THRESHOLD=0.30
MC_DROPOUT_SAMPLES=20

# auto detects GPU if available, falls back to CPU
TORCH_DEVICE=auto

# ---------------------------------------------------------------------------
# FILE STORAGE — local filesystem only
# ---------------------------------------------------------------------------
UPLOAD_DIR=backend/data/uploads
PROCESSED_DIR=backend/data/processed
RESULTS_DIR=backend/data/results
WEIGHTS_DIR=models/weights

MAX_IMAGE_SIZE_BYTES=52428800       # 50 MB
MAX_CSV_SIZE_BYTES=20971520         # 20 MB
MAX_ZIP_SIZE_BYTES=524288000        # 500 MB
MAX_BATCH_IMAGES=100

# ---------------------------------------------------------------------------
# AI FACTORY COPILOT — OpenRouter LLM Gateway
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME="ForgeX • Industrial Decision Intelligence Copilot"
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0.2
COPILOT_ENABLED=true

# ---------------------------------------------------------------------------
# PROCESS ANALYSIS THRESHOLDS
# ---------------------------------------------------------------------------
BOTTLENECK_UTILIZATION_THRESHOLD=0.85
CUSUM_DRIFT_THRESHOLD=5.0
QUEUE_GROWTH_WINDOW=10

# ---------------------------------------------------------------------------
# ECONOMIC MODEL DEFAULTS (overridden by uploaded CSV)
# ---------------------------------------------------------------------------
DEFAULT_SCRAP_COST_PER_UNIT=50.00
DEFAULT_REWORK_COST_PER_UNIT=30.00
DEFAULT_CONTRIBUTION_MARGIN=150.00
DEFAULT_HOURLY_LABOR_COST=25.00
DEFAULT_OVERHEAD_RATE=1.5

# ---------------------------------------------------------------------------
# CORS — allow local frontend only
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
